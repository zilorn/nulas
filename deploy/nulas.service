[Unit]
Description=Nulas configuration API and background worker
After=network.target nulas-web.service
Wants=nulas-web.service

[Service]
Type=simple
User=nulas
Group=nulas
WorkingDirectory=/opt/nulas
ExecStart=/opt/nulas/bin/nulas
Environment=NULAS_SSR_URL=http://127.0.0.1:3001
Environment=NULAS_ADDR=127.0.0.1:8080
Environment=NULAS_DATA_DIR=/var/lib/nulas
Environment=NULAS_CORE_DIR=/var/lib/nulas/core
Environment=NULAS_CORE_INSTALLER=/opt/nulas/scripts/install_core.py
Environment=NULAS_TRAY_SCRIPT=/opt/nulas/scripts/tray.py
EnvironmentFile=-/etc/nulas.env
StateDirectory=nulas
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
# Managed Mihomo needs file capabilities granted by setcap for TUN on exec.
# Keep Nulas unprivileged; do not grant ambient capabilities to the backend.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
