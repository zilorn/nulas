[Unit]
Description=Nulas configuration API and background worker
After=network.target

[Service]
Type=simple
User=nulas
Group=nulas
WorkingDirectory=/opt/nulas
ExecStart=/opt/nulas/bin/nulas
Environment=NULAS_WEB_DIR=/opt/nulas/web/.output/public
Environment=NULAS_ADDR=127.0.0.1:8080
Environment=NULAS_DATA_DIR=/var/lib/nulas
EnvironmentFile=-/etc/nulas.env
StateDirectory=nulas
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
